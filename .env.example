# Awin (optional)
AWIN_PUBLISHER_ID=
AWIN_DEFAULT_MERCHANT_ID=

# Automation: optional remote coupon feed URL (JSON)
COUPON_FEED_URL=
COUPON_FEED_TOKEN=
